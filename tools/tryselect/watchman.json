[
  "trigger",
  ".",
  {
    "name": "rebuild-taskgraph-cache",
    "expression": ["match", "taskcluster/**", "wholename"],
    "command": [
      "./mach",
      "python",
      "--virtualenv",
      "try",
      "-c",
      "from tryselect.tasks import generate_tasks; generate_tasks()"
    ],
    "append_files": false
  }
]
