{
  "include": [
    "**/*.mjs",
    "types/*.ts",
    "../../../tools/@types/browser-window-globals.d.ts"
  ],
  "exclude": [
    "content/SmartbarInput.mjs",
    "private/SuggestBackendRust.sys.mjs",
    "tests/NewtabSearchbarTestUtils.sys.mjs",
    "tests/UrlbarTestUtils.sys.mjs"
  ],
  "extends": "../../../tools/@types/tsconfig.json",

  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,

    "plugins": [
      {
        "transform": "../../../tools/ts/plugins/checkRootOnly.js",
        "transformProgram": true
      }
    ]
  }
}
