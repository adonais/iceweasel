{
  "border": {
    "radius": {
      "value": "{urlbar.border.radius}"
    }
  },
  "separator": {
    "color": {
      "value": {
        "nativeTheme": "color-mix(in srgb, currentColor 14%, transparent)",
        "light": "{color.gray.20}",
        "dark": "{color.gray.60}",
        "forcedColors": "#ffffff"
      }
    }
  },
  "text": {
    "color": {
      "action": {
        "value": {
          "nativeTheme": "LinkText",
          "default": "{toolbar.field.text.color.focus}"
        }
      },
      "secondary": {
        "value": {
          "nativeTheme": "color-mix(in srgb, currentColor 73%, transparent)",
          "light": "#3e315f",
          "dark": "#e7e1f8",
          "forcedColors": "#ffffff"
        }
      }
    }
  }
}
