{
  "include": ["common/**/*.mjs", "lib/**/*.mjs"],
  "exclude": [
    "lib/ActivityStream.sys.mjs",
    "lib/DiscoveryStreamFeed.sys.mjs",
    "lib/ExternalComponentsFeed.sys.mjs",
    "lib/InferredModel/FeatureModel.sys.mjs",
    "lib/InferredPersonalizationFeed.sys.mjs",
    "lib/NewTabAttributionService.sys.mjs",
    "lib/NewTabContentPing.sys.mjs",
    "lib/SmartShortcutsRanker/RankShortcuts.mjs",
    "lib/SmartShortcutsRanker/RankShortcuts.worker.mjs",
    "lib/SmartShortcutsRanker/RankShortcutsWorkerClass.mjs",
    "lib/Wallpapers/WallpaperFeed.sys.mjs"
  ],
  "extends": "../../../tools/@types/tsconfig.json",

  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,

    "plugins": [
      {
        "transform": "../../../tools/ts/plugins/checkRootOnly.js",
        "transformProgram": true
      }
    ]
  }
}
