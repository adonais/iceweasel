include PBackgroundSharedTypes;

[RefCounted] using class mozilla::ipc::DataPipeReceiver from "mozilla/ipc/DataPipe.h";
[RefCounted] using class mozilla::ipc::DataPipeSender from "mozilla/ipc/DataPipe.h";
using mozilla::TimeStamp from "mozilla/TimeStamp.h";

namespace mozilla {
namespace dom {

struct UnidirectionalStream {
  uint64_t streamId;
  nullable DataPipeSender outStream;
};

union UnidirectionalStreamResponse {
  nsresult;
  UnidirectionalStream;
};

struct BidirectionalStream {
  uint64_t streamId;
  nullable DataPipeReceiver inStream;
  nullable DataPipeSender outStream;
};

struct WebTransportDatagramStatsData {
  uint64_t droppedIncoming;
  uint64_t expiredIncoming;
  uint64_t expiredOutgoing;
  uint64_t lostOutgoing;
};

struct WebTransportStatsData {
  uint64_t bytesSent;
  uint64_t bytesAcknowledged;
  uint64_t packetsSent;
  uint64_t bytesLost;
  uint64_t packetsLost;
  uint64_t bytesReceived;
  uint64_t packetsReceived;
  double smoothedRtt;
  double rttVariation;
  double minRtt;
  int64_t estimatedSendRate;   // -1 = null
  bool atSendCapacity;
  WebTransportDatagramStatsData datagrams;
};

union BidirectionalStreamResponse {
  nsresult;
  BidirectionalStream;
};

// errorCode is null when the peer sent no application error code.
struct ResetError {
  uint32_t? errorCode;
};

struct StopSendingError {
  uint32_t? errorCode;
};

union StreamResetOrStopSendingError {
  ResetError;
  StopSendingError;
};

[ChildProc=anydom]
async protocol PWebTransport
{
 parent:
  /**
   * TODO: documentation
   */
  async Close(uint32_t code, nsCString reason)
      returns(WebTransportStatsData? stats);
  async CreateUnidirectionalStream(int64_t sendOrder, uint64_t? sendGroupId)
      returns(UnidirectionalStreamResponse response);
  async CreateBidirectionalStream(int64_t sendOrder, uint64_t? sendGroupId)
      returns(BidirectionalStreamResponse response);

  /**
   * Register a send group with a caller-provided ID
   */
  async CreateSendGroup(uint64_t groupId);

  /**
  * IPC for sending webtransport datagrams
  * @param datagramId unique identifier for tracking promise resolution
  * @param data represents the datagram to be transferred
  * @param timestamp time at which the datagram was created (for maxAge calculation)
  * @param sendGroupId optional send group ID for prioritization (0 = null/default group)
  * @param sendOrder send order for prioritization
  */
  async OutgoingDatagram(uint64_t datagramId, uint8_t[] data, TimeStamp timestamp,
                         uint64_t sendGroupId, int64_t sendOrder)
    returns(nsresult response);

  /**
  * Update datagram queue parameters
  * @param outgoingMaxBufferedDatagrams queue depth before backpressure kicks in
  * @param outgoingMaxAge maximum age in milliseconds (INFINITY for no limit)
  */
  async UpdateDatagramQueueParams(uint32_t outgoingMaxBufferedDatagrams, double outgoingMaxAge);

  /**
  * Get the maximum supported datagram size from necko stack
  */
  async GetMaxDatagramSize()
    returns(uint64_t maxDatagramSize);

  /**
  * Get the http channel id 
  */
  async GetHttpChannelID()
    returns(uint64_t httpChannelID);

  /**
  * Set the sendOrder for an existing stream
  */
  async SetSendOrder(uint64_t streamId, int64_t sendOrder);

  /**
  * Set the sendGroup for an existing stream
  * @param streamId the stream to update
  * @param groupId the send group ID to assign; 0 means no group (null sendGroup)
  */
  async SetSendGroup(uint64_t streamId, uint64_t groupId);

  /**
  * Export keying material for the WebTransport session
  */
  async ExportKeyingMaterial(uint8_t[] label, uint8_t[] context,
                             uint32_t outputLength)
    returns(uint8_t[]? keyingMaterial);

  /**
  * Get connection statistics
  */
  async GetStats()
    returns(WebTransportStatsData? stats);

 child:

  async IncomingUnidirectionalStream(uint64_t streamId, nullable DataPipeReceiver receive);
  async IncomingBidirectionalStream(uint64_t streamId, nullable DataPipeReceiver receive, nullable DataPipeSender send);

  /**
  * IPC for receiving webtransport datagrams
  * @param receivedTime is the time at which the parent received the datagram
  * @param data is the datagram received
  */
  async IncomingDatagram(uint8_t[] data, TimeStamp receivedTime);

  /**
  * Notify child that a datagram is ready (sent or dropped)
  * This allows the content process to resolve the corresponding promise
  * @param datagramId the ID of the datagram that was sent/dropped
  */
  async DatagramReady(uint64_t datagramId);

  /**
  * Notify child of the negotiated protocol and HTTP response headers
  */
  async NegotiatedProtocolAndHeaders(nsCString subprotocol,
                                     WebTransportHeader[] headers);

  async Draining();

  async RemoteClosed(bool cleanly, uint32_t code, nsCString reason,
                     WebTransportStatsData? stats);

  async OnStreamResetOrStopSending(uint64_t streamId,
                                   StreamResetOrStopSendingError error);

  async CloseAll()
      returns(nsresult rv);
};

} // namespace dom
} // namespace mozilla
