// Speculation Rules Prefetch IPC protocol.
//
// One actor pair per prefetch record; managed by PWindowGlobal so that the
// pair is torn down automatically when the document navigates away or the
// window closes.
//
// Spec: https://wicg.github.io/nav-speculation/prefetch.html#prefetch-record

include protocol PWindowGlobal;
include PrefetchIPCTypes;

namespace mozilla {
namespace dom {

async protocol PPrefetchRecord {
  manager PWindowGlobal;

parent:
  // Spec: https://wicg.github.io/nav-speculation/prefetch.html#prefetch-record-cancel-and-discard
  async Cancel();
  async __delete__();
};

}  // namespace dom
}  // namespace mozilla
