MOCHITEST_MANIFESTS += ["test/mochitest.toml"]
BROWSER_CHROME_MANIFESTS += ["test/browser.toml"]

GENERATED_FILES += [
    "SpeechRecognitionModelDisplayInfo.sys.mjs",
    "SpeechRecognitionModels.h",
]
speech_models = GENERATED_FILES["SpeechRecognitionModels.h"]
speech_models.script = "gen_speech_models.py:gen_models_header"
speech_models.inputs = ["models.yaml"]

speech_models_display_info = GENERATED_FILES[
    "SpeechRecognitionModelDisplayInfo.sys.mjs"
]
speech_models_display_info.script = "gen_speech_models.py:gen_models_display_info"
speech_models_display_info.inputs = ["models.yaml"]

EXPORTS.mozilla.dom += [
    "SpeechGrammar.h",
    "SpeechGrammarList.h",
    "SpeechRecognition.h",
    "SpeechRecognitionAlternative.h",
    "SpeechRecognitionBackend.h",
    "SpeechRecognitionModelMapping.h",
    "SpeechRecognitionPhrase.h",
    "SpeechRecognitionResult.h",
    "SpeechRecognitionResultList.h",
    "SpeechTrackListener.h",
]

EXPORTS.mozilla += [
    "AudioCaptureTiming.h",
]

EXPORTS.mozilla.hwinference += [
    "SpeechRecognitionChild.h",
    "SpeechRecognitionParent.h",
]

UNIFIED_SOURCES += [
    "SpeechGrammar.cpp",
    "SpeechGrammarList.cpp",
    "SpeechModelDownloadPermissionRequest.cpp",
    "SpeechModelResolver.cpp",
    "SpeechRecognition.cpp",
    "SpeechRecognitionAlternative.cpp",
    "SpeechRecognitionBackend.cpp",
    "SpeechRecognitionChild.cpp",
    "SpeechRecognitionModelMapping.cpp",
    "SpeechRecognitionParent.cpp",
    "SpeechRecognitionPhrase.cpp",
    "SpeechRecognitionResult.cpp",
    "SpeechRecognitionResultList.cpp",
    "SpeechTrackListener.cpp",
]

IPDL_SOURCES = [
    "PSpeechRecognition.ipdl",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

EXTRA_JS_MODULES += [
    "!SpeechRecognitionModelDisplayInfo.sys.mjs",
    "SpeechRecognitionFeature.sys.mjs",
]

# Bug 1244242 is about enabling on Android
if CONFIG["MOZ_WIDGET_TOOLKIT"] != "android":
    DIRS += ["/third_party/parakeet.cpp"]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"
