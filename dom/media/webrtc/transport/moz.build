with Files("**"):
    BUG_COMPONENT = ("Core", "WebRTC: Networking")

include("/ipc/chromium/chromium-config.mozbuild")

DIRS += [
    "/dom/media/webrtc/transport/third_party",
    "/dom/media/webrtc/transport/build",
    "/dom/media/webrtc/transport/ipc",
    "/dom/media/webrtc/transport/srtp",
]

# Add libFuzzer configuration directives
include("/tools/fuzzing/libfuzzer-config.mozbuild")

if CONFIG["FUZZING_INTERFACES"]:
    TEST_DIRS += ["fuzztest"]

LICENSED_UNDER += ["libjingle"]
LICENSED_UNDER["libjingle"].paths = [
    "sigslot.h",
]

LICENSED_UNDER += ["nicer"]
LICENSED_UNDER["nicer"].paths = [
    "third_party/nICEr",
]

LICENSED_UNDER += ["nrappkit"]
LICENSED_UNDER["nrappkit"].paths = [
    "third_party/nrappkit",
]

LICENSED_UNDER += ["nrappkit-cont-1"]
LICENSED_UNDER["nrappkit-cont-1"].paths = [
    "third_party/nrappkit",
]

LICENSED_UNDER += ["nrappkit-cont-2"]
LICENSED_UNDER["nrappkit-cont-2"].paths = [
    "third_party/nrappkit/src/port/generic/include/sys/queue.h",
]

LICENSED_UNDER += ["nrappkit-cont-3"]
LICENSED_UNDER["nrappkit-cont-3"].paths = [
    "third_party/nrappkit/src/util/util.cpp",
]

LICENSED_UNDER += ["praton1"]
