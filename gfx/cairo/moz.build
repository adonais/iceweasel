DIRS += ['cairo/src']


LICENSES += ["cairo"]
LICENSES["cairo"].title = "Cairo Component Licenses"
LICENSES["cairo"].text = "LICENSE-NOTICE.txt"
LICENSES["cairo"].spdx = "HPND-sell-variant"
LICENSES["cairo"].notice = """
<p>This license, with different copyright holders, applies to certain files of cairo.
            The copyright holders and the applicable ranges of dates are as follows:</p>
            <ul>
              <li>2000 Keith Packard
              <li>2000 SuSE, Inc.
              <li>2004 David Reveman
              <li>2005, 2006 Red Hat, Inc.
              <li>2006 Mozilla Corporation
              <li>2006, 2010 Joonas Pihlaja
              <li>2007 Netlabs
              <li>2011 Andrea Canciani
            </ul>
"""

LICENSED_UNDER += ["cairo"]
LICENSED_UNDER["cairo"].paths = [
    "cairo/src/cairo-freelist-private.h",
    "cairo/src/cairo-freelist-type-private.h",
    "cairo/src/cairo-freelist.c",
    "cairo/src/cairo-pattern.c",
    "cairo/src/cairo-time-private.h",
    "cairo/src/cairo-time.c",
    "cairo/src/cairo-xcb-resources.c",
    "cairo/src/cairo-xlib-screen.c",
    "cairo/src/cairo-xlib-xrender-private.h",
]

LICENSED_UNDER += ["mit"]
LICENSED_UNDER["mit"].paths = [
    "cairo/src/cairo-clip-tor-scan-converter.c",
    "cairo/src/cairo-mono-scan-converter.c",
    "cairo/src/cairo-spans-private.h",
    "cairo/src/cairo-spans.c",
    "cairo/src/cairo-tor-scan-converter.c",
    "cairo/src/cairo-tor22-scan-converter.c",
]
