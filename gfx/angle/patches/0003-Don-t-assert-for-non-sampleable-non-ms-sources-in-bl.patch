From 92c954813e0878032e7a7487461461fd805908d0 Mon Sep 17 00:00:00 2001
From: Jeff Gilbert <jdashg@gmail.com>
Date: Thu, 11 Feb 2021 17:34:00 -0800
Subject: [PATCH] Don't assert for non-sampleable non-ms sources in
 blitRenderbufferRect if we can CopySubResource.

In Firefox, we can have a source from DirectComposition without
D3D11_BIND_SHADER_RESOURCE. This is fine so long as our formats etc
match enough to hit the CopySubResource path.
Firefox bug: https://bugzilla.mozilla.org/show_bug.cgi?id=1692355
---
 .../renderer/d3d/d3d11/Renderer11.cpp         | 38 +++++++++++--------
 1 file changed, 22 insertions(+), 16 deletions(-)

diff --git a/src/libANGLE/renderer/d3d/d3d11/Renderer11.cpp b/src/libANGLE/renderer/d3d/d3d11/Renderer11.cpp
index 0565a594f..ebad18ad2 100644
--- a/src/libANGLE/renderer/d3d/d3d11/Renderer11.cpp
+++ b/src/libANGLE/renderer/d3d/d3d11/Renderer11.cpp
@@ -3769,6 +3769,13 @@ angle::Result Renderer11::blitRenderbufferRect(const gl::Context *context,
         return angle::Result::Continue;
     }
 
+    const bool canCopySubresource =
+        drawRenderTarget->getSamples() == readRenderTarget->getSamples() &&
+        readRenderTarget11->getFormatSet().formatID ==
+            drawRenderTarget11->getFormatSet().formatID &&
+        !stretchRequired && !outOfBounds && !reversalRequired && !partialDSBlit &&
+        !colorMaskingNeeded && (!(depthBlit || stencilBlit) || wholeBufferCopy);
+
     TextureHelper11 readTexture;
     unsigned int readSubresource = 0;
     d3d11::SharedSRV readSRV;
@@ -3778,7 +3785,7 @@ angle::Result Renderer11::blitRenderbufferRect(const gl::Context *context,
         ANGLE_TRY(resolveMultisampledTexture(context, readRenderTarget11, depthBlit, stencilBlit,
                                              &readTexture));
 
-        if (!stencilBlit)
+        if (!stencilBlit && !canCopySubresource)
         {
             const auto &readFormatSet = readTexture.getFormatSet();
 
@@ -3797,27 +3804,26 @@ angle::Result Renderer11::blitRenderbufferRect(const gl::Context *context,
         ASSERT(readRenderTarget11);
         readTexture     = readRenderTarget11->getTexture();
         readSubresource = readRenderTarget11->getSubresourceIndex();
-        const d3d11::SharedSRV *blitSRV;
-        ANGLE_TRY(readRenderTarget11->getBlitShaderResourceView(context, &blitSRV));
-        readSRV = blitSRV->makeCopy();
-        if (!readSRV.valid())
+        if (!canCopySubresource)
         {
-            ASSERT(depthBlit || stencilBlit);
-            const d3d11::SharedSRV *srv;
-            ANGLE_TRY(readRenderTarget11->getShaderResourceView(context, &srv));
-            readSRV = srv->makeCopy();
+            const d3d11::SharedSRV *blitSRV;
+            ANGLE_TRY(readRenderTarget11->getBlitShaderResourceView(context, &blitSRV));
+            readSRV = blitSRV->makeCopy();
+            if (!readSRV.valid())
+            {
+                ASSERT(depthBlit || stencilBlit);
+                const d3d11::SharedSRV *srv;
+                ANGLE_TRY(readRenderTarget11->getShaderResourceView(context, &srv));
+                readSRV = srv->makeCopy();
+            }
+            ASSERT(readSRV.valid());
         }
-        ASSERT(readSRV.valid());
     }
 
     // Stencil blits don't use shaders.
-    ASSERT(readSRV.valid() || stencilBlit);
+    ASSERT(readSRV.valid() || stencilBlit || canCopySubresource);
 
-    if (drawRenderTarget->getSamples() == readRenderTarget->getSamples() &&
-        readRenderTarget11->getFormatSet().formatID ==
-            drawRenderTarget11->getFormatSet().formatID &&
-        !stretchRequired && !outOfBounds && !reversalRequired && !partialDSBlit &&
-        !colorMaskingNeeded && (!(depthBlit || stencilBlit) || wholeBufferCopy))
+    if (canCopySubresource)
     {
         UINT dstX = drawRect.x;
         UINT dstY = drawRect.y;
-- 
