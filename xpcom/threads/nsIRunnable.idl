#include "nsISupports.idl"

/**
 * Represents a task which can be dispatched to a thread for execution.
 */

[scriptable, function, uuid(4a2abaf0-6886-11d3-9382-00104ba0fd40)]
interface nsIRunnable : nsISupports
{
    /**
     * The function implementing the task to be run.
     */
    void run();
};

[scriptable, uuid(e75aa42a-80a9-11e6-afb5-e89d87348e2c)]
interface nsIRunnablePriority : nsISupports
{
    // LOWEST is available to TaskController tasks only, hence not declared
    // here. It is for work that only wants the main thread's leftovers: it
    // loses against every other priority, idle included, and is interrupted
    // as soon as anything else becomes ready. Unlike an idle task it does not
    // need an idle period, so it can also run when there is none.
    // const unsigned long PRIORITY_LOWEST = 0;
    const unsigned long PRIORITY_IDLE = 1;
    const unsigned long PRIORITY_DEFERRED_TIMERS = 2;
    const unsigned long PRIORITY_LOW = 3;
    // INPUT_LOW isn't supposed to be used directly.
    // const unsigned long PRIORITY_INPUT_LOW = 4;
    const unsigned long PRIORITY_NORMAL = 5;
    const unsigned long PRIORITY_MEDIUMHIGH = 6;
    const unsigned long PRIORITY_INPUT_HIGH = 7;
    const unsigned long PRIORITY_VSYNC = 8;
    // INPUT_HIGHEST is InputTaskManager's internal priority
    //const unsigned long PRIORITY_INPUT_HIGHEST = 9;
    const unsigned long PRIORITY_RENDER_BLOCKING = 10;
    const unsigned long PRIORITY_CONTROL = 11;

    readonly attribute unsigned long priority;
};

[uuid(3114c36c-a482-4c6e-9523-1dcfc6f605b9)]
interface nsIRunnableIPCMessageType : nsISupports
{
    readonly attribute unsigned long type;
};
