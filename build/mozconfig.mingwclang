. "$topsrcdir/build/mozconfig.win-common"
. "$topsrcdir/browser/config/mozconfigs/common"

export MOZ_PACKAGE_JSSHELL=1

# MinGW Stuff
ac_add_options --target=${MINGW_CPU}-pc-windows-gnu
ac_add_options --with-toolchain-prefix=${MINGW_CPU}-w64-mingw32-

ac_add_options --disable-warnings-as-errors

# These replicate Tor's configuration
ac_add_options --enable-proxy-bypass-protection
ac_add_options --enable-disk-remnant-avoidance

# These aren't supported on mingw at this time
ac_add_options --disable-webrtc # Bug 1393901
ac_add_options --disable-default-browser-agent # Relies on toast notifications which don't build on mingw.
ac_add_options --disable-notification-server # Toast notifications don't build on mingw.

# Find our toolchain
HOST_CC="$MOZ_FETCHES_DIR/clang/bin/clang"
HOST_CXX="$MOZ_FETCHES_DIR/clang/bin/clang++"
CC="$MOZ_FETCHES_DIR/clang/bin/${MINGW_CPU}-w64-mingw32-clang"
CXX="$MOZ_FETCHES_DIR/clang/bin/${MINGW_CPU}-w64-mingw32-clang++"
CFLAGS="$CFLAGS -fcrash-diagnostics-dir=${UPLOAD_PATH} -include _mingw.h"
CXXFLAGS="-fms-extensions -fcrash-diagnostics-dir=${UPLOAD_PATH} -include _mingw.h"

mk_add_options "export PATH=$MOZ_FETCHES_DIR/clang/bin:$MOZ_FETCHES_DIR/fxc2/bin:$PATH"

ac_add_options --with-branding=browser/branding/nightly

. "$topsrcdir/build/mozconfig.common.override"
