@template
def Library(name):
    LIBRARY_NAME = name


@template
def RustLibrary(name, output_category=None):
    Library(name)

    IS_RUST_LIBRARY = True
    if output_category:
        RUST_LIBRARY_OUTPUT_CATEGORY = output_category


DIRS += [
    "archive",
    "middle",
    "rust",
]
