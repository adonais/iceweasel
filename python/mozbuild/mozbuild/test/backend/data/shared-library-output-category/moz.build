@template
def SharedLibrary(name, output_category=None):
    LIBRARY_NAME = name
    FORCE_SHARED_LIB = True
    if output_category:
        SHARED_LIBRARY_OUTPUT_CATEGORY = output_category


DIRS += [
    "with-output-category",
    "without-output-category",
]
