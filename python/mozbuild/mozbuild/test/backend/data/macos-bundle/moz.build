DIRS += ["gen"]

MACOS_BUNDLES += [
    {
        "bundle": "!/dist/bin/Test.app",
        "skeleton": "skeleton",
        "info_plist": "!gen/Info.plist",
        "strings": "!InfoPlist.strings",
        "lproj": "English.lproj",
        "binaries": [["!/dist/bin/test-bin", "test-bin"]],
        "extra_files": [["!/dist/bin/Extra", "Frameworks/Extra.framework/Extra"]],
        "stage": None,
        "macos_files": None,
        "macos_copy_files": None,
        "moves": [],
        "pkginfo": None,
        "copies": ["!/dist/bin/Test-copy.app"],
    },
    {
        "bundle": "!/dist/Staged.app",
        "skeleton": "skeleton",
        "info_plist": "!Info.plist",
        "strings": "!InfoPlist.strings",
        "lproj": "en.lproj",
        "binaries": [],
        "extra_files": [],
        "stage": "!/dist/bin",
        "macos_files": "!macos-files.txt",
        "macos_copy_files": "macos-copy.in",
        "moves": [["ChannelPrefs.framework", "Frameworks/ChannelPrefs.framework"]],
        "pkginfo": "APPLMOZB",
        "copies": [],
    },
    {
        "bundle": "!/dist/other/Test.app",
        "skeleton": "skeleton",
        "info_plist": "!Info.plist",
        "strings": "!InfoPlist.strings",
        "lproj": "English.lproj",
        "binaries": [["!/dist/bin/test-bin", "test-bin"]],
        "extra_files": [],
        "stage": None,
        "macos_files": None,
        "macos_copy_files": None,
        "moves": [],
        "pkginfo": None,
        "copies": [],
    },
]
