@template
def Library(name):
    """Template for libraries."""
    LIBRARY_NAME = name


@template
def RustLibrary(name):
    """Template for Rust libraries."""
    Library(name)

    IS_RUST_LIBRARY = True


RustLibrary("test-flags-library")

DEFINES["MOZ_RUST_SPEC_CFLAG"] = True
HOST_DEFINES["MOZ_RUST_SPEC_HOST_CFLAG"] = True
LDFLAGS += ["-Wl,--moz-rust-spec-ldflag"]

RUST_TESTS = ["flags-tests"]
