@template
def Library(name):
    """Template for libraries."""
    LIBRARY_NAME = name


@template
def RustLibrary(name, lto):
    """Template for Rust libraries."""
    Library(name)

    IS_RUST_LIBRARY = True
    if not lto:
        RUST_LIBRARY_NO_LTO = True


RustLibrary("no-lto-library", False)
