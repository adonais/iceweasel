FINAL_LIBRARY = "js"

# Includes should be relative to parent path
LOCAL_INCLUDES += ["!../..", "../.."]

include("../../js-compileflags.mozbuild")
include("../../js-config.mozbuild")
include("../../js-cxxflags.mozbuild")

LOCAL_INCLUDES += [
    "/intl/icu_capi/bindings/cpp",
]

UNIFIED_SOURCES += [
    "Calendar.cpp",
    "CalendarFields.cpp",
    "Duration.cpp",
    "Instant.cpp",
    "Int96.cpp",
    "PlainDate.cpp",
    "PlainDateTime.cpp",
    "PlainMonthDay.cpp",
    "PlainTime.cpp",
    "PlainYearMonth.cpp",
    "Temporal.cpp",
    "TemporalNow.cpp",
    "TemporalParser.cpp",
    "TimeZone.cpp",
    "ToString.cpp",
    "ZonedDateTime.cpp",
]

if CONFIG["FUZZING_JS_FUZZILLI"]:
    include("/tools/fuzzing/libfuzzer-config.mozbuild")

SOURCE_HEADERS += [
    "Calendar.h",
    "CalendarFields.h",
    "Duration.h",
    "Era.h",
    "Instant.h",
    "Int96.h",
    "MonthCode.h",
    "PlainDate.h",
    "PlainDateTime.h",
    "PlainMonthDay.h",
    "PlainTime.h",
    "PlainYearMonth.h",
    "Temporal.h",
    "TemporalNow.h",
    "TemporalParser.h",
    "TemporalRoundingMode.h",
    "TemporalTypes.h",
    "TemporalUnit.h",
    "TimeZone.h",
    "ToString.h",
    "ZonedDateTime.h",
]
