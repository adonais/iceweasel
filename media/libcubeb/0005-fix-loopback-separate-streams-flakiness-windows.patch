+ * stop to consume queued virtual-device data. */
+const int32_t CONTINUOUS_TONE_FRAMES = SAMPLE_FREQUENCY / 2; /* ~500ms */
+const unsigned int LOOPBACK_PLAY_MS = 600;
+const unsigned int LOOPBACK_DRAIN_MS = 600;

