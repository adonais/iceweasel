	"hdr_dynamic_vivid_metadata.h",
	"hwcontext.h",
	"hwcontext_drm.h",
	"hwcontext_internal.h",
	"hwcontext_vaapi.h",
	"hwcontext_vulkan.h",
	"imgutils.h",
	"imgutils_internal.h",
	"integer.h",
	"internal.h",
	"intfloat.h",
	"intmath.h",
	"intreadwrite.h",
	"libm.h",
	"lls.h",
	"log.h",
	"macros.h",
	"mastering_display_metadata.h",
	"mathematics.h",
	"mem.h",
	"mem_internal.h",
	"opt.h",
	"parseutils.h",
	"pixdesc.h",
	"pixelutils.h",
	"pixfmt.h",
	"qsort.h",
	"random_seed.h",
	"rational.h",
	"refstruct.h",
	"replaygain.h",
	"reverse.h",
	"samplefmt.h",
	"sfc64.h",
	"side_data.h",
	"slicethread.h",
	"stereo3d.h",
	"thread.h",
	"threadmessage.h",
	"time_internal.h",
	"timecode.h",
	"timecode_internal.h",
	"timer.h",
	"timestamp.h",
	"tx_priv.h",
