EXPORTS.mozilla = ["Compression.h"]

UNIFIED_SOURCES += [
    "Compression.cpp",
]

SOURCES += [
    "lz4/lz4.c",
    "lz4/lz4file.c",
    "lz4/lz4frame.c",
    "lz4/lz4hc.c",
    "xxhash/xxhash.c",
]

SOURCES["xxhash/xxhash.c"].flags += ["-Wno-unused-function"]

LOCAL_INCLUDES += ["xxhash"]

DEFINES["LZ4LIB_VISIBILITY"] = ""
DEFINES["LZ4FLIB_VISIBILITY"] = ""

LICENSES += ["lz4", "xxhash"]
LICENSES["lz4"].title = "LZ4 License"
LICENSES["lz4"].text = "lz4/LICENSE"
LICENSES["xxhash"].title = "xxHash License"
LICENSES["xxhash"].text = "xxhash/LICENSE"

LICENSED_UNDER += ["lz4", "xxhash"]
LICENSED_UNDER["lz4"].paths = ["lz4"]
LICENSED_UNDER["xxhash"].paths = ["xxhash"]

# By putting it in js, it ends up in libxul too.
FINAL_LIBRARY = "js"
