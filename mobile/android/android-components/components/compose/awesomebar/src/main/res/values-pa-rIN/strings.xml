<resources>
  <!-- Description for the button to accept the search suggestion and continue editing the search. -->
  <string name="mozac_browser_awesomebar_edit_suggestion">ਸੁਝਾਅ ਮੰਨੋ ਤੇ ਸੋਧੋ</string>
  <!-- Description for the button to remove the search suggestion from the displayed results. -->
  <string name="mozac_browser_awesomebar_remove_suggestion">ਸੁਝਾਅ ਨੂੰ ਹਟਾਓ</string>
  <!--
    The description for the stock suggestion card when the stock is decreasing.
    %s is a placeholder that will be replaced by the change percent value
  -->
  <string name="mozac_browser_awesomebar_stock_suggestion_decrease">%s ਫ਼ੀਸਦੀ ਘਟੇ</string>
  <!--
    The description for the stock suggestion card when the stock is increasing.
    %s is a placeholder that will be replaced by the change percent value
  -->
  <string name="mozac_browser_awesomebar_stock_suggestion_increase">%s ਫ਼ੀਸਦੀ ਵਧੇ</string>
  <!-- Description for the stock suggestion card when the stock is the same. -->
  <string name="mozac_browser_awesomebar_stock_suggestion_no_change">ਕੋਈ ਤਬਦੀਲੀ ਨਹੀਂ</string>
  <!-- Description for the button to share the highlighted awesomebar element (URL, search query, etc.) -->
  <string name="mozac_browser_awesomebar_share_website_details">ਸਾਂਝਾ ਕਰੋ</string>
  <!-- Description for the button to copy the highlighted awesomebar element (URL, search query, etc.) -->
  <string name="mozac_browser_awesomebar_copy_website_details">ਕਾਪੀ ਕਰੋ</string>
  <!-- Description for the button to edit the highlighted awesomebar element (URL, search query, etc.) -->
  <string name="mozac_browser_awesomebar_edit_website_details">URL ਨੂੰ ਸੋਧੋ</string>
  <!--
    Description for the highlighted awesomebar element, which represents the current webpage - clicking it reloads the webpage.
    This will be interpolated into a longer message, equivalent to "Double tap to [reload the current page]" in English. Structure and phrasing vary by target language: using an infinitive/dictionary form of the verb is recommended.
  -->
  <string name="mozac_browser_awesomebar_reload_website">ਮੌਜੂਦਾ ਸਫ਼ੇ ਨੂੰ ਮੁੜ-ਲੋਡ ਕਰੋ</string>
</resources>
