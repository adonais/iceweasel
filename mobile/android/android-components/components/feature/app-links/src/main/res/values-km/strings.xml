<resources>
  <!-- The tile for the list of external apps to open the link in -->
  <string name="mozac_feature_applinks_open_in">បើក​ក្នុង…</string>
  <!-- The title of the prompt that warns users their normal browsing session is trying to open another app -->
  <string name="mozac_feature_applinks_normal_confirm_dialog_title">បើកនៅក្នុងកម្មវិធីផ្សេងទៀត</string>
  <!-- The title of the prompt that warns users their normal browsing session is trying to open another app -->
  <string name="mozac_feature_applinks_normal_confirm_dialog_title_2">បើកបញ្ជាប់នេះនៅក្នុងកម្មវិធីផ្សេងទៀតឬ?</string>
  <!--
    The title of the prompt with app suffix.
    %s is a placeholder that will be replaced by an app name
  -->
  <string name="mozac_feature_applinks_normal_confirm_dialog_title_with_app_name_2">បើកបញ្ជាប់នេះនៅក្នុងកម្មវិធី %s ឬ?</string>
  <!--
    The message of the prompt to confirm with users that they want to open the link in another app
    %s is a placeholder that will be replaced by the app name
  -->
  <string name="mozac_feature_applinks_normal_confirm_dialog_message">តើអ្នកចង់ទុកឲ្យ %s មើលខ្លឹមសារនេះទេ?</string>
  <!-- Opens the selected time -->
  <string name="mozac_feature_applinks_confirm_dialog_confirm">បើក</string>
  <!-- Opens the selected app link -->
  <string name="mozac_feature_applinks_confirm_dialog_confirm_2">បើក​ក្នុង​កម្មវិធី</string>
  <!-- Cancels the prompt -->
  <string name="mozac_feature_applinks_confirm_dialog_deny">បោះបង់</string>
  <!-- The label of the checkbox that, depending of user's choice, can change the Open links in apps setting -->
  <string name="mozac_feature_applinks_confirm_dialog_checkbox_label">បើកបញ្ជាប់នៅក្នុងកម្មវិធីជានិច្ច</string>
  <!-- The label for the expandable section that shows additional details -->
  <string name="mozac_feature_applinks_view_details">មើលព័ត៌មានលម្អិត</string>
  <!-- The label for the expandable section when details are shown -->
  <string name="mozac_feature_applinks_hide_details">លាក់​ព័ត៌មាន​លម្អិត​</string>
  <!-- The label for the source URL in the details section -->
  <string name="mozac_feature_applinks_source_url">ប្រភព URL</string>
  <!-- The label for the destination URL in the details section -->
  <string name="mozac_feature_applinks_destination_url">ទិសដៅ URL</string>
  <!-- The label for the URL if opening in the browser in the details section. %s is the browser name. -->
  <string name="mozac_feature_applinks_firefox_url">URL ប្រសិនបើបើកនៅក្នុង %s</string>
  <!-- The text shown when there is no Firefox URL -->
  <string name="mozac_feature_applinks_none">គ្មាន</string>
  <!-- The subtitle showing where the link was navigated from. %s is the domain. -->
  <string name="mozac_feature_applinks_link_from">បញ្ជាប់មកពី %s</string>
</resources>
