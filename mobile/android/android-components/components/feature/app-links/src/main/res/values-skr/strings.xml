<resources>
  <!-- The tile for the list of external apps to open the link in -->
  <string name="mozac_feature_applinks_open_in">۔۔۔ وچ کھولو</string>
  <!-- The title of the prompt that warns users their normal browsing session is trying to open another app -->
  <string name="mozac_feature_applinks_normal_confirm_dialog_title">ہک ٻئی ایپ وچ کھولو</string>
  <!-- The title of the prompt that warns users their normal browsing session is trying to open another app -->
  <string name="mozac_feature_applinks_normal_confirm_dialog_title_2">کیا اے لنک کہیں ٻئی ایپ وچ کھولݨ چاہندے او؟</string>
  <!--
    The title of the prompt with app suffix.
    %s is a placeholder that will be replaced by an app name
  -->
  <string name="mozac_feature_applinks_normal_confirm_dialog_title_with_app_name_2">کیا اے لنک %s ایپ وچ کھولݨ چاہندے او؟</string>
  <!--
    The message of the prompt to confirm with users that they want to open the link in another app
    %s is a placeholder that will be replaced by the app name
  -->
  <string name="mozac_feature_applinks_normal_confirm_dialog_message">بھلا تساں ایہ مواد ݙیکھݨ کیتے %s کوں چھوڑݨ پسند کریسو؟</string>
  <!-- Opens the selected time -->
  <string name="mozac_feature_applinks_confirm_dialog_confirm">کھولو</string>
  <!-- Opens the selected app link -->
  <string name="mozac_feature_applinks_confirm_dialog_confirm_2">ایپ کوں کھولو</string>
  <!-- Cancels the prompt -->
  <string name="mozac_feature_applinks_confirm_dialog_deny">منسوخ</string>
  <!-- The label of the checkbox that, depending of user's choice, can change the Open links in apps setting -->
  <string name="mozac_feature_applinks_confirm_dialog_checkbox_label">ہر ویلے ایپ لنکس اوپن رہون</string>
  <!-- The label for the expandable section that shows additional details -->
  <string name="mozac_feature_applinks_view_details">تفصیل ڈیکھو</string>
  <!-- The label for the expandable section when details are shown -->
  <string name="mozac_feature_applinks_hide_details">تفصیلاں لُکاؤ</string>
  <!-- The label for the source URL in the details section -->
  <string name="mozac_feature_applinks_source_url">ماخذ یو آر ایل</string>
  <!-- The label for the destination URL in the details section -->
  <string name="mozac_feature_applinks_destination_url">یو آر ایل دی منزل</string>
  <!-- The label for the URL if opening in the browser in the details section. %s is the browser name. -->
  <string name="mozac_feature_applinks_firefox_url">%s وچ کھولݨ دی صورت وچ یو آر ایل (URL)</string>
  <!-- The label for the unique identifier in the details section -->
  <string name="mozac_feature_applinks_unique_identifier">منفرد شناخت کار</string>
  <!-- The text shown when there is no Firefox URL -->
  <string name="mozac_feature_applinks_none">کوئی وی کائنی</string>
  <!-- The subtitle showing where the link was navigated from. %s is the domain. -->
  <string name="mozac_feature_applinks_link_from">%s طرفوں لنک</string>
</resources>
