with Files("**"):
    BUG_COMPONENT = ("Firefox", "Shell Integration")

UNIFIED_SOURCES = [
    "msixcomserver.cpp",
]

USE_LIBS += [
    "msixcomserver_s",
]

OS_LIBS += [
    "advapi32",
    "bcrypt",
    "synchronization",
]

DEFFILE = "msixcomserver.def"
USE_STATIC_MSVCRT = True

SharedLibrary("msixcomserver")
