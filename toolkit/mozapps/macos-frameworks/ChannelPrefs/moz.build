with Files("**"):
    BUG_COMPONENT = ("Toolkit", "Application Update")

Framework("ChannelPrefs")

EXPORTS += [
    "ChannelPrefs.h",
]

UNIFIED_SOURCES += [
    "ChannelPrefs.mm",
]

OS_LIBS += [
    "-framework Foundation",
]

# `Framework("ChannelPrefs")` builds only the bare binary. Assemble the
# `ChannelPrefs.framework` the build consumes, taking the binary from the
# upstream `-localbuild` framework in artifact builds.
if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    if CONFIG["COMPILE_ENVIRONMENT"]:
        FINAL_TARGET_FILES["ChannelPrefs.framework"] += [f"!/{FINAL_TARGET}/ChannelPrefs"]
    elif CONFIG["MOZ_ARTIFACT_BUILDS"]:
        FINAL_TARGET_FILES["ChannelPrefs.framework"] += [
            "!/dist/update_framework_artifacts/ChannelPrefs-localbuild.framework/ChannelPrefs"
        ]
    FINAL_TARGET_FILES["ChannelPrefs.framework"].Resources += ["Info.plist"]
