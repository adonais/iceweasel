with Files("**"):
    BUG_COMPONENT = ("Firefox", "Installer")

SPHINX_TREES["docs"] = "docs"

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    Program("org.mozilla.dmgInstallHelper")

    SOURCES = ["dmgInstallHelper.mm"]

    OS_LIBS += ["-framework Cocoa", "-framework Security"]

    CMMFLAGS += [
        "-fobjc-arc",
    ]

    GeneratedFile(
        "dmgInstallHelper-Info.plist",
        script="/python/mozbuild/mozbuild/action/preprocessor.py",
        entry_point="generate",
        inputs=["Info.plist.in"],
        flags=[
            "-Fsubstitution",
            f"-DMOZ_SMAUTHORIZEDCLIENTS_REQUIREMENTS={CONFIG['MOZ_SMAUTHORIZEDCLIENTS_REQUIREMENTS']}",
        ],
    )

    LDFLAGS += [
        "-sectcreate",
        "__TEXT",
        "__info_plist",
        f"{OBJDIR}/dmgInstallHelper-Info.plist",
        "-sectcreate",
        "__TEXT",
        "__launchd_plist",
        SRCDIR + "/Launchd.plist",
    ]

    EXTRA_LINK_DEPS += ["!dmgInstallHelper-Info.plist", "Launchd.plist"]

    EXPORTS += ["dmgInstallProtocol.h"]
