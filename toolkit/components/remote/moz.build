with Files("**"):
    BUG_COMPONENT = ("Toolkit", "Startup and Profile System")

SOURCES += [
    "nsRemoteService.cpp",
]

SOURCE_HEADERS += [
    "nsRemoteClient.h",
    "nsRemoteServer.h",
    "nsRemoteService.h",
]

BROWSER_CHROME_MANIFESTS += ["tests/browser/browser.toml"]

XPCOM_MANIFESTS += [
    "components.conf",
]

XPIDL_SOURCES += [
    "nsIRemoteService.idl",
]

XPIDL_MODULE = "toolkitremote"

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    SOURCES += [
        "nsUnixRemoteServer.cpp",
        "RemoteUtils.cpp",
    ]
    if CONFIG["MOZ_ENABLE_DBUS"]:
        SOURCES += [
            "nsDBusRemoteClient.cpp",
            "nsDBusRemoteServer.cpp",
        ]

        SOURCE_HEADERS += [
            "nsDBusRemoteClient.h",
            "nsDBusRemoteServer.h",
        ]

        EXPORTS += [
            "nsUnixRemoteServer.h",
            "RemoteUtils.h",
        ]
        CXXFLAGS += CONFIG["MOZ_DBUS_CFLAGS"]
    else:
        SOURCES += [
            "nsGTKRemoteServer.cpp",
            "nsXRemoteClient.cpp",
            "nsXRemoteServer.cpp",
        ]

        SOURCE_HEADERS += [
            "nsGTKRemoteServer.h",
            "nsXRemoteClient.h",
            "nsXRemoteServer.h",
        ]
    CXXFLAGS += CONFIG["MOZ_GTK3_CFLAGS"]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "windows":
    SOURCES += [
        "nsWinRemoteClient.cpp",
        "nsWinRemoteServer.cpp",
        "WinRemoteMessage.cpp",
    ]
    SOURCE_HEADERS += [
        "nsWinRemoteClient.h",
        "nsWinRemoteServer.h",
        "WinRemoteMessage.h",
    ]
if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    SOURCES += [
        "nsMacRemoteClient.mm",
        "nsMacRemoteServer.mm",
    ]
    SOURCE_HEADERS += [
        "nsMacRemoteClient.h",
        "nsMacRemoteServer.h",
    ]

LOCAL_INCLUDES += [
    "../../profile",
    "../../xre",
]
FINAL_LIBRARY = "xul"
