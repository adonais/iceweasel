{
  "background": {
    "color": {
      "@base": {
        "value": {
          "nativeTheme": "Field",
          "default": "{popup.background.color}"
        }
      }
    }
  },
  "border": {
    "color": {
      "value": {
        "nativeTheme": "{border.color.deemphasized.@base}",
        "default": "{popup.border.color}"
      }
    },
    "radius": {
      "value": "{popup.border.radius}"
    }
  },
  "text": {
    "color": {
      "@base": {
        "value": {
          "nativeTheme": "FieldText",
          "default": "{text.color.@base}"
        }
      }
    }
  }
}
