{
  "border": {
    "radius": {
      "value": "{border.radius.small}"
    }
  },
  "margin": {
    "@base": {
      "comment": "Block margin must be 0 so that there's always an item highlighted and no dead space when moving the pointer across items.",
      "value": "0 {panel-menuitem.margin.inline}"
    },
    "inline": {
      "value": "8px"
    }
  },
  "padding": {
    "@base": {
      "value": "{panel-menuitem.padding.block} {panel-menuitem.padding.inline}"
    },
    "block": {
      "value": "8px"
    },
    "inline": {
      "value": "8px"
    }
  }
}
