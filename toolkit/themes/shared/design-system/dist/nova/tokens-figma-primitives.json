{
  "border/radius/xsmall": 4,
  "border/radius/small": 8,
  "border/radius/medium": 12,
  "border/radius/xlarge": 24,
  "size/item/xsmall": 12,
  "size/item/small": 16,
  "size/item/medium": 24,
  "size/item/large": 32,
  "size/item/xlarge": 48,
  "button/border/radius": "{Primitives$border/radius/xlarge}",
  "button/border/width/split": 0,
  "button/gap/split": 0,
  "button/padding/inline/small": "{Primitives$space/medium}",
  "card/gap": "{Primitives$space/medium}",
  "icon/size/xsmall": "{Primitives$size/item/xsmall}",
  "icon/size/small": "{Primitives$size/item/small}",
  "icon/size/medium": 20,
