  "page-nav/focus/outline/offset": "{Primitives$focus/outline/offset}",
  "page-nav/focus/padding": "calc(var(--focus-outline-offset) + var(--focus-outline-width))",
  "select/min/height/small": "{Primitives$button/min-height/small}",
  "select/padding/block": "{Primitives$button/padding/block}",
  "select/space/inline": "{Primitives$button/padding/inline}",
  "select/space/inline/small": "{Primitives$space/medium}",
  "tab/margin/block": 6,
  "tab/border/radius": "{Primitives$toolbarbutton/border/radius}",
  "tab/border/color/accent": "linear-gradient(96deg, var(--tab-border-color-selected-leading) 20.68%, var(--tab-border-color-selected-trailing) 79.34%)",
  "tab/box/shadow/selected": "none",
  "tab/outline/offset": -1,
  "urlbar/border/radius": "{Primitives$popup/border/radius}",
  "urlbarview/border/radius": "{Primitives$urlbar/border/radius}"
