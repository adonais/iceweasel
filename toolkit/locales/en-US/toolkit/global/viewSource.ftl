## Go to line prompt, opened from the context menu of a view-source page

view-source-go-to-line-title = Go to line
view-source-go-to-line-text = Enter line number
view-source-invalid-input-title = Invalid input
view-source-invalid-input-text = The line number entered is invalid.
view-source-out-of-range-title = Line not found
view-source-out-of-range-text = The specified line was not found.

##

# Title of the page displayed when viewing the source of a selection.
view-source-selection-title = DOM Source of Selection

## Context menu items, only visible when viewing the source of a page

view-source-context-go-to-line =
    .label = Go to Line…
    .accesskey = L
view-source-context-wrap-long-lines-2 =
    .label = Wrap Long Lines
    .accesskey = o
view-source-context-highlight-syntax-2 =
    .label = Syntax Highlighting
    .accesskey = x
