DIRS += ["glue"]

if not CONFIG["MOZ_WASM_SANDBOXING_HUNSPELL"]:
    DIRS += ["src"]

if CONFIG["ENABLE_TESTS"]:
    XPCSHELL_TESTS_MANIFESTS += ["tests/unit/xpcshell.toml"]

LICENSES += ["myspell"]
LICENSES["myspell"].title = "MySpell License"
# Not the library's own COPYING.MPL: this is the MySpell license the files in
# src/ carry, which upstream ships only as the comment header reproduced in
# src/license.myspell.
LICENSES["myspell"].text = "LICENSE-NOTICE.txt"
LICENSES["myspell"].spdx = "BSD-2-Clause"
LICENSES["myspell"].subcomponent = True
LICENSES["myspell"].notice = """
<p>This license applies to some files in the directory <code>extensions/spellcheck/hunspell</code>.</p>
"""

LICENSED_UNDER += [
    "mit",
    "myspell",
]
